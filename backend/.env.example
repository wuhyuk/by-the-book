# backend/.env 로 복사해서 값을 채운다. .env는 커밋하지 않는다.
LLM_PROVIDER=
LLM_API_KEY=
# 기본 모델은 gemini-3.1-flash-lite (MVP_SPEC 9절, 2026-11-08 결정)
LLM_MODEL=

# 선택 설정 (llm/config.py). 줄을 지우거나 주석으로 두면 괄호 안 기본값을 쓴다.
# LLM_TEMPERATURE: 기본 0. "LLM_TEMPERATURE=" 처럼 값을 비우면 temperature를 보내지 않는다.
# LLM_TEMPERATURE=0
# LLM_MAX_RPM: 모델별 분당 호출 상한 (기본 12, 무료 한도 RPM 15보다 낮게)
# LLM_MAX_RPM=12
# LLM_FALLBACK_MODEL: 기본 모델이 재시도 후에도 429일 때 1회 부를 예비 모델 (기본 비움, 확정 후보 gemini-3.5-flash-lite: MVP_SPEC 9절)
LLM_FALLBACK_MODEL=

# 운영 스위치 (api/settings.py, 2026-11-11). 줄을 지우거나 값을 비우면 괄호 안 기본값을 쓴다.
# ANALYZE_ENABLED: 문장 분석 사용 여부 (기본 true). false면 /api/analyze가 Gemini를 부르지 않고 폼 입력을 안내한다.
ANALYZE_ENABLED=true
# DAILY_ANALYZE_LIMIT: 하루(KST) Gemini 호출 상한 (기본 450). 재시도·예비 모델 호출도 1회씩 센다.
# 카운터는 프로세스 메모리에만 있어 서버를 다시 시작하면 0으로 초기화된다.
DAILY_ANALYZE_LIMIT=450
# SURVEY_URL: 화면에 보여 줄 설문 링크 (기본 비움 = 표시 안 함). http(s) 주소만 쓴다.
SURVEY_URL=
